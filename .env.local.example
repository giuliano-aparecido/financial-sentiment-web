# Server-side only — never prefix with NEXT_PUBLIC_, these must not reach the browser bundle.

# Base URL of the Render-hosted RAG API (no trailing slash).
RAG_API_URL=https://financial-rag-api.onrender.com

# Shared secret sent as the X-API-Key header to the RAG API.
# The Render API must check this same value to authorize requests.
RAG_API_KEY=replace-with-a-long-random-secret

# --- Auth (Google OAuth via NextAuth) ---
# Not needed in local dev, which auto-signs in as a fixed dev user instead.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# NextAuth URL (optional, defaults to http://localhost:3000 in dev;
# set to your deployed Vercel URL in production)
NEXTAUTH_URL=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist of Google account emails permitted to sign in.
# This app has no database, so this list - not Google sign-in alone - is
# what actually restricts access. Empty/unset denies everyone.
ALLOWED_EMAILS=you@example.com
